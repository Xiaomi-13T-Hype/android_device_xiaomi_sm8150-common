android_app_import {
    name: "XiaomiDolby",
    apk: "XiaomiDolby.apk",
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
