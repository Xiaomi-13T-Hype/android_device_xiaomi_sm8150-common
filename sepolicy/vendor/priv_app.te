# Allow privileged apps (N0KontzzzManager, Lunaris Parts) to control battery supply nodes (Bypass Charging, health)
allow priv_app vendor_sysfs_battery_supply:dir r_dir_perms;
allow priv_app vendor_sysfs_battery_supply:file rw_file_perms;

# Allow Leica Camera / MiuiCamera to find and use Xiaomi campostproc HIDL service
allow priv_app hal_campostproc_hwservice:hwservice_manager find;
binder_call(priv_app, hal_camera_default)

